{
  "name": "@analytic-system/analytic-system-make-file",
  "icon": "icon-source.png",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "build": "vite build",
    "dev": "vite",
    "icons:create": "node scripts/create-icons.cjs",
    "prebuild": "npm run icons:create",
    "server:build:win": "cd server-analytic-system && python -m venv .venv && .venv\\Scripts\\python.exe -m pip install --upgrade pip && .venv\\Scripts\\python.exe -m pip install -r requirements.txt && .venv\\Scripts\\python.exe build.py --mode pyinstaller --target current --project-name server-analytic-system --clean",
    "server:build:linux": "cd server-analytic-system && python3 -m venv .venv && .venv/bin/python -m pip install --upgrade pip && .venv/bin/python -m pip install -r requirements.txt && .venv/bin/python build.py --mode pyinstaller --target current --project-name server-analytic-system --clean",
    "electron:dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && electron .\"",
    "server:dev:win": "cd server-analytic-system && if exist .venv\\Scripts\\python.exe (.venv\\Scripts\\python.exe main.py) else (python main.py)",
    "server:dev:linux": "cd server-analytic-system && ( [ -x .venv/bin/python ] && .venv/bin/python main.py || python3 main.py )",
    "electron:dev:win": "set NODE_ENV=development && concurrently -k \"npm run server:dev:win\" \"npm run electron:dev\"",
    "electron:dev:linux": "NODE_ENV=development concurrently -k \"npm run server:dev:linux\" \"npm run electron:dev\"",
    "electron:build:win": "npm run prebuild && npm run server:build:win && npm run build && node scripts/before-build.cjs && npx electron-builder --windows && node scripts/protect-asar.cjs",
    "electron:build:linux": "npm run prebuild && npm run server:build:linux && npm run build && node scripts/before-build.cjs && npx electron-builder --linux && node scripts/protect-asar.cjs",
    "electron:build:win:store": "npm run prebuild && npm run server:build:win && npm run build && node scripts/before-build.cjs && npx electron-builder --windows --config.win.target=appx && node scripts/protect-asar.cjs",
    "electron:build:linux:deb": "npm run prebuild && npm run server:build:linux && npm run build && node scripts/before-build.cjs && npx electron-builder --linux deb && node scripts/protect-asar.cjs",
    "electron:build:linux:snap": "npm run prebuild && npm run server:build:linux && npm run build && node scripts/before-build.cjs && npx electron-builder --linux snap && node scripts/protect-asar.cjs",
    "protect:asar": "node scripts/protect-asar.cjs"
  },
  "dependencies": {
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@mui/icons-material": "7.3.5",
    "@mui/material": "7.3.5",
    "@popperjs/core": "2.11.8",
    "@radix-ui/react-accordion": "1.2.3",
    "@radix-ui/react-alert-dialog": "1.1.6",
    "@radix-ui/react-aspect-ratio": "1.1.2",
    "@radix-ui/react-avatar": "1.1.3",
    "@radix-ui/react-checkbox": "1.1.4",
    "@radix-ui/react-collapsible": "1.1.3",
    "@radix-ui/react-context-menu": "2.2.6",
    "@radix-ui/react-dialog": "1.1.6",
    "@radix-ui/react-dropdown-menu": "2.1.6",
    "@radix-ui/react-hover-card": "1.1.6",
    "@radix-ui/react-label": "2.1.2",
    "@radix-ui/react-menubar": "1.1.6",
    "@radix-ui/react-navigation-menu": "1.2.5",
    "@radix-ui/react-popover": "1.1.6",
    "@radix-ui/react-progress": "1.1.2",
    "@radix-ui/react-radio-group": "1.2.3",
    "@radix-ui/react-scroll-area": "1.2.3",
    "@radix-ui/react-select": "2.1.6",
    "@radix-ui/react-separator": "1.1.2",
    "@radix-ui/react-slider": "1.2.3",
    "@radix-ui/react-slot": "1.1.2",
    "@radix-ui/react-switch": "1.1.3",
    "@radix-ui/react-tabs": "1.1.3",
    "@radix-ui/react-toggle": "1.1.2",
    "@radix-ui/react-toggle-group": "1.1.2",
    "@radix-ui/react-tooltip": "1.1.8",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "3.6.0",
    "electron-log": "^5.4.3",
    "electron-updater": "^6.3.9",
    "embla-carousel-react": "8.6.0",
    "input-otp": "1.4.2",
    "lucide-react": "0.487.0",
    "motion": "12.23.24",
    "next-themes": "0.4.6",
    "react-day-picker": "8.10.1",
    "react-dnd": "16.0.1",
    "react-dnd-html5-backend": "16.0.1",
    "react-hook-form": "7.55.0",
    "react-popper": "2.3.0",
    "react-resizable-panels": "2.1.7",
    "react-responsive-masonry": "2.7.1",
    "react-router": "7.13.0",
    "react-router-dom": "^7.13.1",
    "react-slick": "0.31.0",
    "recharts": "2.15.2",
    "sonner": "2.0.3",
    "tailwind-merge": "3.2.0",
    "tw-animate-css": "1.3.8",
    "vaul": "1.1.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.12",
    "@vitejs/plugin-react": "4.7.0",
    "concurrently": "^9.2.1",
    "electron": "^37.10.3",
    "electron-builder": "^26.0.12",
    "electron-builder-squirrel-windows": "^26.0.12",
    "electron-notarize": "^1.2.2",
    "tailwindcss": "4.1.12",
    "vite": "6.3.5",
    "wait-on": "^8.0.5"
  },
  "peerDependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "pnpm": {
    "overrides": {
      "vite": "6.3.5"
    }
  },
   "build": {
    "appId": "com.invest.analytics.desktop",
    "productName": "NK-Invest-Analytics",
    "copyright": "Copyright © 2024 NK-Invest Analytics",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "server-analytic-system/dist/server-analytic-system/",
        "to": "server",
        "filter": ["**/*"]
      }
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/@*/**/*.node",
      "server/**/*"
    ],

    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64", "ia32"] },
        { "target": "portable", "arch": ["x64"] },
        { "target": "appx", "arch": ["x64", "arm64"] },
        { "target": "msi", "arch": ["x64"] }
      ],
      "icon": "build/icon.ico",
      "artifactName": "${productName}-Windows-${version}-${arch}.${ext}",
      "verifyUpdateCodeSignature": false,
      "signAndEditExecutable": false
    },

    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Инвестиционная аналитика",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "language": "1049",
      "multiLanguageInstaller": true,
      "unicode": true
    },

    "portable": {
      "artifactName": "${productName}-Windows-${version}-portable-${arch}.${ext}",
      "splashImage": "build/splash.bmp",
      "unpackDirName": "data"
    },

    "appx": {
      "applicationId": "InvestAnalytics.Desktop",
      "identityName": "42694InvestAnalytics.InvestAnalytics",
      "publisher": "CN=AAAAAAAA-AAAA-AAAA-AAAA-AAAAAAAAAAAA",
      "publisherDisplayName": "Invest Analytics",
      "languages": ["ru-RU", "en-US"],
      "showNameOnTiles": true,
      "backgroundColor": "#2D2D30"
    },

    "linux": {
      "target": [
        { "target": "deb", "arch": ["x64", "arm64"] },
        { "target": "AppImage", "arch": ["x64"] }
      ],
      "icon": "build/icon.png",
      "category": "Finance",
      "maintainer": "NK-Invest-Analytics <nikitakaev25@gmail.com>",
      "vendor": "NK-Invest-Analytics",
      "description": "Профессиональная аналитическая система для инвестиций",
      "desktop": {
        "entry": {
          "Categories": "Finance;Office;",
          "StartupWMClass": "invest-analytics",
          "MimeType": "x-scheme-handler/invest-analytics"
        }
      },
      "artifactName": "${productName}-Linux-${version}-${arch}.${ext}",
      "synopsis": "NK-Investment Analytics Desktop Application",
      "executableArgs": []
    },

    "deb": {
      "priority": "optional",
      "packageCategory": "utils",
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0",
        "libappindicator3-1"
      ],
      "recommends": ["python3", "python3-pip"],
      "afterInstall": "build/linux/after-install.sh",
      "afterRemove": "build/linux/after-remove.sh"
    },

    "snap": {
      "confinement": "strict",
      "grade": "stable",
      "summary": "NK-Invest-Analytics",
      "description": "Professional investment analytics system",
      "plugs": ["desktop", "desktop-legacy", "home", "x11", "wayland", "unity7", "browser-support", "network", "gsettings", "pulseaudio", "opengl"],
      "environment": {
        "DISABLE_WAYLAND": "1"
      }
    },

    "rpm": {
      "depends": ["gtk3", "libnotify", "nss", "libXScrnSaver", "libXtst", "xdg-utils", "at-spi2-core", "libuuid"]
    },

    "publish": [
      {
        "provider": "github",
        "releaseType": "release"
      }
    ],

    "afterPack": "scripts/after-pack.cjs",
    "beforeBuild": "scripts/before-build.cjs"
  }
}
