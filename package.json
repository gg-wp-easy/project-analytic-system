{
  "name": "@analytic-system/analytic-system-make-file",
  "icon": "icon-source.png",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "author": {
    "name": "Nikita Kaev",
    "email": "nikitakaev25@gmail.com"
  },
  "scripts": {
    "start": "electron .",
    "build": "vite build --configLoader native",
    "dev": "vite",
    "icons:create": "node scripts/create-icons.cjs",
    "prebuild": "npm run icons:create",
    "desktop:dev": "npm run electron:dev",
    "desktop:build": "npm run electron:build",
    "desktop:build:win": "npm run electron:build:win",
    "desktop:build:linux": "npm run electron:build:linux",
    "desktop:build:mac": "npm run electron:build:mac",
    "desktop:prod": "npm run electron:build",
    "desktop:prod:win": "npm run electron:build:win",
    "desktop:prod:linux": "npm run electron:build:linux",
    "desktop:prod:mac": "npm run electron:build:mac",
    "server:install": "node scripts/servers.cjs install all",
    "server:build": "node scripts/servers.cjs build all",
    "server:build:win": "npm run server:build",
    "server:build:linux": "npm run server:build",
    "servers:install": "node scripts/servers.cjs install all",
    "servers:build": "node scripts/servers.cjs build all",
    "servers:build:win": "npm run servers:build",
    "servers:build:linux": "npm run servers:build",
    "analytics-server:install": "node scripts/servers.cjs install analytics",
    "analytics-server:build": "node scripts/servers.cjs build analytics",
    "analytics-server:dev": "node scripts/servers.cjs dev analytics",
    "news-server:install": "node scripts/servers.cjs install news",
    "news-server:build": "node scripts/servers.cjs build news",
    "news-server:dev": "node scripts/servers.cjs dev news",
    "server:dev": "node scripts/servers.cjs dev analytics",
    "electron:dev": "node scripts/electron.cjs dev",
    "electron:dev:win": "npm run electron:dev",
    "electron:dev:linux": "npm run electron:dev",
    "electron:dev:mac": "npm run electron:dev",
    "electron:build": "node scripts/electron.cjs build",
    "electron:build:win": "node scripts/electron.cjs build --platform=win",
    "electron:build:win:msi": "node scripts/electron.cjs build --platform=win --profile=msi",
    "electron:build:win:store": "node scripts/electron.cjs build --platform=win --profile=store",
    "electron:build:linux": "node scripts/electron.cjs build --platform=linux",
    "electron:build:mac": "node scripts/electron.cjs build --platform=mac",
    "protect:asar": "node scripts/protect-asar.cjs"
  },
  "dependencies": {
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@mui/icons-material": "7.3.5",
    "@mui/material": "7.3.5",
    "@popperjs/core": "2.11.8",
    "@radix-ui/react-accordion": "1.2.3",
    "@radix-ui/react-alert-dialog": "1.1.6",
    "@radix-ui/react-aspect-ratio": "1.1.2",
    "@radix-ui/react-avatar": "1.1.3",
    "@radix-ui/react-checkbox": "1.1.4",
    "@radix-ui/react-collapsible": "1.1.3",
    "@radix-ui/react-context-menu": "2.2.6",
    "@radix-ui/react-dialog": "1.1.6",
    "@radix-ui/react-dropdown-menu": "2.1.6",
    "@radix-ui/react-hover-card": "1.1.6",
    "@radix-ui/react-label": "2.1.2",
    "@radix-ui/react-menubar": "1.1.6",
    "@radix-ui/react-navigation-menu": "1.2.5",
    "@radix-ui/react-popover": "1.1.6",
    "@radix-ui/react-progress": "1.1.2",
    "@radix-ui/react-radio-group": "1.2.3",
    "@radix-ui/react-scroll-area": "1.2.3",
    "@radix-ui/react-select": "2.1.6",
    "@radix-ui/react-separator": "1.1.2",
    "@radix-ui/react-slider": "1.2.3",
    "@radix-ui/react-slot": "1.1.2",
    "@radix-ui/react-switch": "1.1.3",
    "@radix-ui/react-tabs": "1.1.3",
    "@radix-ui/react-toggle": "1.1.2",
    "@radix-ui/react-toggle-group": "1.1.2",
    "@radix-ui/react-tooltip": "1.1.8",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "3.6.0",
    "electron-log": "^5.4.3",
    "electron-updater": "^6.3.9",
    "embla-carousel-react": "8.6.0",
    "input-otp": "1.4.2",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.7",
    "lucide-react": "0.487.0",
    "motion": "12.23.24",
    "next-themes": "0.4.6",
    "react-day-picker": "8.10.1",
    "react-dnd": "16.0.1",
    "react-dnd-html5-backend": "16.0.1",
    "react-hook-form": "7.55.0",
    "react-popper": "2.3.0",
    "react-resizable-panels": "2.1.7",
    "react-responsive-masonry": "2.7.1",
    "react-router": "7.13.0",
    "react-router-dom": "^7.13.1",
    "react-slick": "0.31.0",
    "recharts": "2.15.2",
    "sonner": "2.0.3",
    "tailwind-merge": "3.2.0",
    "tw-animate-css": "1.3.8",
    "vaul": "1.1.2",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.12",
    "@vitejs/plugin-react": "4.7.0",
    "electron": "^37.10.3",
    "electron-builder": "^26.0.12",
    "electron-builder-squirrel-windows": "^26.0.12",
    "electron-icon-builder": "^2.0.1",
    "electron-notarize": "^1.2.2",
    "tailwindcss": "4.1.12",
    "vite": "6.3.5"
  },
  "peerDependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "pnpm": {
    "overrides": {
      "vite": "6.3.5"
    }
  },
  "build": {
    "appId": "com.invest.analytics.desktop",
    "productName": "NK-Invest-Analytics",
    "copyright": "Copyright © 2024 NK-Invest-Analytics",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "server-analytic-system/dist/server-analytic-system/",
        "to": "server",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "server-news-analytic/dist/news-assistant/",
        "to": "news-server",
        "filter": [
          "**/*"
        ]
      }
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/@*/**/*.node",
      "server/**/*",
      "news-server/**/*"
    ],
    "executableName": "nk-invest-analytics",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "ia32"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icons/icon.ico",
      "artifactName": "${productName}-Windows-${version}-${arch}.${ext}",
      "verifyUpdateCodeSignature": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Инвестиционная аналитика",
      "installerIcon": "build/icons/icon.ico",
      "uninstallerIcon": "build/icons/icon.ico",
      "installerHeaderIcon": "build/icons/icon.ico",
      "language": "1049",
      "multiLanguageInstaller": true,
      "unicode": true
    },
    "portable": {
      "artifactName": "${productName}-Windows-${version}-portable-${arch}.${ext}",
      "splashImage": "build/splash.bmp",
      "unpackDirName": "data"
    },
    "appx": {
      "applicationId": "InvestAnalytics.Desktop",
      "identityName": "42694InvestAnalytics.InvestAnalytics",
      "publisher": "CN=AAAAAAAA-AAAA-AAAA-AAAA-AAAAAAAAAAAA",
      "publisherDisplayName": "Invest Analytics",
      "languages": [
        "ru-RU",
        "en-US"
      ],
      "showNameOnTiles": true,
      "backgroundColor": "#2D2D30"
    },
    "linux": {
      "target": [
        {
          "target": "deb",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icons",
      "category": "Finance",
      "maintainer": "NK-Invest-Analytics <nikitakaev25@gmail.com>",
      "vendor": "NK-Invest-Analytics",
      "description": "Профессиональная аналитическая система для инвестиций",
      "desktop": {
        "entry": {
          "Categories": "Finance;Office;",
          "StartupWMClass": "invest-analytics",
          "MimeType": "x-scheme-handler/invest-analytics"
        }
      },
      "artifactName": "${productName}-Linux-${version}-${arch}.${ext}",
      "synopsis": "NK-Investment Analytics Desktop Application",
      "executableArgs": []
    },
    "deb": {
      "priority": "optional",
      "packageCategory": "utils",
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0",
        "libappindicator3-1"
      ],
      "recommends": [
        "python3",
        "python3-pip"
      ],
      "afterInstall": "build/linux/after-install.sh",
      "afterRemove": "build/linux/after-remove.sh"
    },
    "snap": {
      "confinement": "strict",
      "grade": "stable",
      "summary": "NK-Invest-Analytics",
      "description": "Professional investment analytics system",
      "plugs": [
        "desktop",
        "desktop-legacy",
        "home",
        "x11",
        "wayland",
        "unity7",
        "browser-support",
        "network",
        "gsettings",
        "pulseaudio",
        "opengl"
      ],
      "environment": {
        "DISABLE_WAYLAND": "1"
      }
    },
    "rpm": {
      "depends": [
        "gtk3",
        "libnotify",
        "nss",
        "libXScrnSaver",
        "libXtst",
        "xdg-utils",
        "at-spi2-core",
        "libuuid"
      ]
    },
    "publish": [
      {
        "provider": "github",
        "releaseType": "release"
      }
    ],
    "afterPack": "scripts/after-pack.cjs"
  }
}
